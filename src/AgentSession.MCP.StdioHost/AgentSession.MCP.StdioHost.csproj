<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>AgentSession.MCP</PackageId>
    <PackageVersion>0.1.0-beta</PackageVersion>
    <PackageTags>AI; MCP; server; stdio; session</PackageTags>
    <Description>.NET 10 MCP server for restart-safe shared sessions, multi-agent coordination and repository-scoped reusable memory with semantic recall.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="OnuObservability.Hosting" />
    <PackageReference Include="OnuObservability.Mcp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentSession.MCP.Core/AgentSession.MCP.Core.csproj" />
    <ProjectReference Include="../AgentSession.MCP.Protocol/AgentSession.MCP.Protocol.csproj" />
    <ProjectReference Include="../Modules/Session/AgentSession.MCP.Session/AgentSession.MCP.Session.csproj" />
    <ProjectReference Include="../Modules/AgentMemory/AgentSession.MCP.AgentMemory/AgentSession.MCP.AgentMemory.csproj" />
    <ProjectReference Include="../AgentSession.MCP.Infrastructure/AgentSession.MCP.Infrastructure.csproj" />
    <ProjectReference Include="../AgentSession.MCP.ServiceDefaults/AgentSession.MCP.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
